# Настройки службы моста (/etc/conf.d/icq-tg-bridge)

# От чьего имени работает мост.
bridge_user="icqbridge"

# Куда установлен проект.
bridge_dir="/opt/icq-tg-bridge"

# Файл настроек.
bridge_config="/opt/icq-tg-bridge/config.toml"

# Подробность журнала обычно задаётся в config.toml, секция [log]. Здесь её
# можно перекрыть, не трогая конфиг, — например, временно включить DEBUG.
# Пусто — берётся из config.toml.
bridge_loglevel=""

# Отдельно — записи самой библиотеки Telethon (в config.toml: telethon_level).
# Пусто — из config.toml; там по умолчанию WARNING.
bridge_telethon_loglevel=""
